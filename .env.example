# ── TypeSafe / Jev ──────────────────────────────────────────────────────────
# Primary: TypeSafe direct API (waitlist-gated)
TYPESAFE_API_KEY=

# Fallback: OpenRouter OpenAI-compatible endpoint (model: typesafe/jev-1.13)
# Used automatically when TYPESAFE_API_KEY is not set.
OPENROUTER_API_KEY=

# ── GitHub ───────────────────────────────────────────────────────────────────
# Personal access token (or fine-grained PAT) with:
#   repo > pull_requests: read
#   repo > issues: write   (for label management + PR comments)
# In GitHub Actions this is provided automatically as secrets.GITHUB_TOKEN.
GITHUB_TOKEN=

# ── Target PR (for local dry-run) ────────────────────────────────────────────
# The PR to analyse when running scripts/dry_run.py locally.
# Accepts either a full URL or OWNER/REPO#NUMBER format.
# Example: https://github.com/octocat/Hello-World/pull/1
DRY_RUN_PR=

# ── Confidence thresholds (optional — these are the defaults) ────────────────
# Labels are auto-applied when model confidence meets or exceeds the threshold.
# Below threshold the bot posts a comment and leaves the label to a human.
RISK_CONFIDENCE_THRESHOLD=0.75
COMPLEXITY_CONFIDENCE_THRESHOLD=0.70

# ── Diff truncation (optional — these are the defaults) ──────────────────────
MAX_DIFF_CHARS=8000     # max chars of raw diff sent to Jev
MAX_FILE_CHARS=8000     # max chars per file before per-file truncation kicks in
